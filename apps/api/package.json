{
  "name": "@kairo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "build": "npx --yes esbuild@0.28.1 src/server.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --outfile=dist/server.js --external:fastify --external:jose --external:pg",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@kairo/contracts": "0.1.0",
    "@kairo/domain": "0.1.0",
    "@kairo/worker": "0.1.0",
    "fastify": "5.10.0",
    "jose": "6.2.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
