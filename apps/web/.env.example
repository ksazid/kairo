# Kairo Web — OIDC/Auth0 configuration
# Keep OIDC_CLIENT_SECRET in the deployment platform's secret store. Never commit a real value.
OIDC_ISSUER=https://your-tenant.us.auth0.com/
OIDC_CLIENT_ID=your-auth0-client-id
OIDC_CLIENT_SECRET=replace-in-secret-store
OIDC_AUDIENCE=urn:kairo:api

# Kairo API origin used by server-side Web requests.
KAIRO_API_URL=http://127.0.0.1:4000
